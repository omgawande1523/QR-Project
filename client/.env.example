# Copy to .env (or .env.local) and adjust. Only VITE_* variables reach the browser,
# so never put secrets here.

# Backend REST API base URL (no trailing slash)
VITE_API_URL=http://localhost:5000

# Socket.io server URL; defaults to VITE_API_URL when empty
VITE_SOCKET_URL=

# Public address of the site (e.g. https://qrmenu.example.com), no trailing slash. Used for the
# Open Graph image URL, canonical link and sitemap.xml; link previews need it in production.
VITE_SITE_URL=
