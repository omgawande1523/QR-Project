# Settings for the staff app build (npm run app:build / app:apk / app:aab), read by `vite build --mode app`.
# Copy to .env.app.local (not committed) and pick one block. Only VITE_* values are used; never put secrets here.

# --- Android emulator on this PC (default when nothing is set) ---
# 10.0.2.2 is the PC itself as seen from the emulator.
VITE_API_URL=http://10.0.2.2:5000
VITE_SITE_URL=http://10.0.2.2:3000

# --- A real phone on the same Wi-Fi as this PC ---
# Use the PC's address from `ipconfig` (IPv4 Address). Debug APKs allow plain http; the server needs no
# change because the app's origins are allowed already.
# VITE_API_URL=http://192.168.1.20:5000
# VITE_SITE_URL=http://192.168.1.20:3000

# --- Release (Play Store) ---
# https is required for release builds (npm run app:aab refuses http).
# VITE_API_URL=https://api.example.com
# VITE_SITE_URL=https://menu.example.com
# VITE_CONTACT_EMAIL=support@example.com
