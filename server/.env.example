# Copy to server/.env and fill in. Never commit the real .env.

NODE_ENV=development
PORT=5000

# Local MongoDB, or a MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/qr-menu

# Required, at least 32 characters. The server refuses to start without it. Generate one with node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Customer/dashboard site: allowed CORS origin and base URL used in password-reset links
FRONTEND_URL=http://localhost:3000

# Extra allowed origins, comma separated (localhost:3000/3001 are added automatically in development)
CORS_ORIGINS=

# Reverse proxies in front of the API: 0 locally, 1 on Render/Railway, so rate limits see real client IPs
TRUST_PROXY=0

# SMTP login for password-reset emails (Gmail app password). Leave blank to disable.
EMAIL_USER=
EMAIL_PASS=

# Public base URL of this API (used in links to uploaded images). Defaults to http://localhost:PORT.
PUBLIC_URL=http://localhost:5000

# Image storage: "local" saves files under UPLOAD_DIR (default server/uploads) and serves them at /uploads.
# "cloudinary" stores them in Cloudinary instead: use it on Render and other hosts whose disk is wiped on deploy.
STORAGE_DRIVER=local
UPLOAD_DIR=

# For STORAGE_DRIVER=cloudinary: the "API environment variable" from the Cloudinary console,
# cloudinary://<api_key>:<api_secret>@<cloud_name>, and the folder images go in (default qr-menu)
CLOUDINARY_URL=
CLOUDINARY_FOLDER=

# Automatic removal of images added more than 24 hours ago that nothing uses; set to off to disable
UPLOAD_CLEANUP=
