{
  "name": "qr-menu",
  "version": "1.0.0",
  "private": true,
  "description": "QR code digital menu and table ordering system for restaurants and cafés",
  "engines": {
    "node": ">=22.12",
    "npm": ">=10"
  },
  "scripts": {
    "install:all": "npm install && cd server && npm install && cd ../client && npm install && cd ../mobile && npm install",
    "dev": "concurrently --names server,client --prefix-colors green,cyan --kill-others-on-fail \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "seed": "npm --prefix server run seed",
    "seed:review": "npm --prefix server run seed:review",
    "test": "npm --prefix server test && npm --prefix client test",
    "lint": "npm --prefix client run lint",
    "e2e": "playwright test",
    "e2e:prod": "npm run build && playwright test --config playwright.prod.config.js",
    "app:doctor": "node mobile/scripts/app.mjs doctor",
    "app:build": "node mobile/scripts/app.mjs build",
    "app:sync": "node mobile/scripts/app.mjs sync",
    "app:open": "node mobile/scripts/app.mjs open",
    "app:run": "node mobile/scripts/app.mjs run",
    "app:apk": "node mobile/scripts/app.mjs apk",
    "app:aab": "node mobile/scripts/app.mjs aab",
    "e2e:app": "playwright test --config playwright.app.config.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.2.5",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0"
  }
}
